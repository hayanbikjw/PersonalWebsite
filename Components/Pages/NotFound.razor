@page "/not-found"
@layout MainLayout

<PageTitle>404 · Not Found</PageTitle>

<section class="page-hero not-found">
    <div class="hero__sky" aria-hidden="true">
        <canvas class="sky"></canvas>
        <Constellation Kind="cassiopeia" Class="constellation--page" />
    </div>
    <h1 class="not-found__code" aria-label="404">
        <span style="--i:0">4</span><span style="--i:1">0</span><span style="--i:2">4</span>
    </h1>
    <p class="page-hero__sub">앗, 찾으시는 페이지가 없어요.</p>
    <a class="btn btn--primary" href=""><Icon Name="arrow-left" Size="18" /><span>홈으로</span></a>
</section>
